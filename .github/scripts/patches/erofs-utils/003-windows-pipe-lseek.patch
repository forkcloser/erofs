+#ifdef _WIN32
+	/* On Windows, lseek() on pipes misleadingly "succeeds" - it returns
+	 * the current pipe buffer size for SEEK_END and silently no-ops for
+	 * SEEK_CUR/SEEK_SET.  This causes erofs_iostream_lskip() to use
+	 * lseek-based skipping, which does not actually advance the read
+	 * position, silently corrupting the tar stream parse.
+	 *
+	 * Detect pipes via GetFileType() and force the non-seekable path. */
+	bool is_pipe = false;
+	{
+		HANDLE h = (HANDLE)_get_osfhandle(fd);
+		if (h != INVALID_HANDLE_VALUE &&
+		    GetFileType(h) == FILE_TYPE_PIPE)
+			is_pipe = true;
+	}
+#endif
+
+#ifdef _WIN32
+	/* On Windows, ensure stdin is in blocking binary mode */
+	_setmode(fd, _O_BINARY);
